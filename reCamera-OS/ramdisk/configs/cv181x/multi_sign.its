/*
 * U-Boot uImage source file with multiple kernels, ramdisks and FDT blobs
 */

/dts-v1/;

/ {
	description = "Various kernels, ramdisks and FDT blobs";
	#address-cells = <2>;

	images {
		kernel-1 {
			description = "cvitek kernel";
			data = /incbin/("./Image.gz");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "gzip";
			load = <0x0 0x80080000>;
			entry = <0x0 0x80080000>;
			hash-2 {
				algo = "crc32";
			};
			signature {
				algo = "sha256,rsa2048";
				key-name-hint = "test_reeos";
				required = "image";
				sign-images = "kernel-1";
			};
		};

		ramdisk-1 {
			description = "cvitek ramdisk";
			data = /incbin/("./rootfs.cpio.gz");
			type = "ramdisk";
			arch = "arm64";
			os = "linux";
			compression = "gzip";
			load = <00000000>;
			entry = <00000000>;
			hash-1 {
				algo = "crc32";
			};
			signature {
				algo = "sha256,rsa2048";
				key-name-hint = "test_reeos";
				required = "image";
				sign-images = "ramdisk-1";
			};
		};

		/*FDT*/

	};

	/*CFG*/

};
